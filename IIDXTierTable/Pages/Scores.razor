@page "/scores"
@using IIDXTierTable.Models
@using IIDXTierTable.Services
@inject BrowserStorageService Storage

<PageTitle>Scores</PageTitle>

<h1>Scores</h1>

@if (data is null)
{
    <div class="alert alert-info" role="alert">
        저장된 데이터가 없습니다. 먼저 Import 페이지에서 CSV를 저장해 주세요.
    </div>
}
else
{
    <section class="dashboard-grid">
        <article class="metric-card">
            <p class="metric-label">총 곡 수</p>
            <p class="metric-value">@data.Songs.Count</p>
        </article>
        <article class="metric-card">
            <p class="metric-label">플레이한 곡</p>
            <p class="metric-value">@data.Songs.Count(song => song.PlayCount > 0)</p>
        </article>
        <article class="metric-card">
            <p class="metric-label">최근 플레이</p>
            <p class="metric-value metric-date">@GetLatestPlayedText()</p>
        </article>
    </section>

    <section class="filter-bar">
        <input class="form-control" placeholder="제목/아티스트 검색" @bind="searchText" @bind:event="oninput" />

        <select class="form-select" @bind="selectedVersion">
            <option value="ALL">모든 버전</option>
            @foreach (var version in Versions)
            {
                <option value="@version">@version</option>
            }
        </select>

        <select class="form-select" @bind="selectedDifficulty">
            @foreach (var difficulty in IidxDifficultyNames.All)
            {
                <option value="@difficulty">@difficulty</option>
            }
        </select>

        <select class="form-select" @bind="selectedClearType">
            <option value="ALL">모든 클리어 타입</option>
            @foreach (var clearType in ClearTypes)
            {
                <option value="@clearType">@clearType</option>
            }
        </select>
    </section>

    @if (!FilteredSongs.Any())
    {
        <p class="mt-3"><em>필터 조건에 맞는 데이터가 없습니다.</em></p>
    }
    else
    {
        <div class="table-wrap mt-3">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>버전</th>
                        <th>제목</th>
                        <th>아티스트</th>
                        <th>플레이</th>
                        <th>@selectedDifficulty 레벨</th>
                        <th>@selectedDifficulty 스코어</th>
                        <th>@selectedDifficulty 클리어</th>
                        <th>@selectedDifficulty DJ LEVEL</th>
                        <th>@selectedDifficulty 미스카운트</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var song in FilteredSongs)
                    {
                        var d = GetDifficulty(song, selectedDifficulty);
                        <tr>
                            <td>@song.Version</td>
                            <td>@song.Title</td>
                            <td>@song.Artist</td>
                            <td>@song.PlayCount</td>
                            <td>@d.Level</td>
                            <td>@d.Score</td>
                            <td>@d.ClearType</td>
                            <td>@d.DjLevel</td>
                            <td>@d.MissCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private IidxScoreEnvelope? data;
    private string searchText = string.Empty;
    private string selectedVersion = "ALL";
    private string selectedDifficulty = "ANOTHER";
    private string selectedClearType = "ALL";

    private IEnumerable<string> Versions => data?.Songs
        .OrderBy(song => song.VersionSortOrder)
        .Select(song => song.Version)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        ?? Enumerable.Empty<string>();

    private IEnumerable<string> ClearTypes => data?.Songs
        .Select(song => GetDifficulty(song, selectedDifficulty).ClearType)
        .Where(static clearType => !string.IsNullOrWhiteSpace(clearType))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(static clearType => clearType)
        ?? Enumerable.Empty<string>();

    private IEnumerable<IidxSongRecord> FilteredSongs => (data?.Songs ?? [])
        .Where(song => selectedVersion == "ALL" || string.Equals(song.Version, selectedVersion, StringComparison.OrdinalIgnoreCase))
        .Where(song => string.IsNullOrWhiteSpace(searchText)
            || song.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || song.Artist.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .Where(song => selectedClearType == "ALL"
            || string.Equals(GetDifficulty(song, selectedDifficulty).ClearType, selectedClearType, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(song => song.PlayCount)
        .ThenBy(song => song.Title);

    protected override async Task OnInitializedAsync()
    {
        data = await Storage.GetItemAsync<IidxScoreEnvelope>(IidxStorageKeys.Scores);
    }

    private string GetLatestPlayedText()
    {
        if (data is null)
        {
            return "-";
        }

        var latest = data.Songs
            .Where(song => song.LastPlayedAt.HasValue)
            .Select(song => song.LastPlayedAt!.Value)
            .DefaultIfEmpty()
            .Max();

        return latest == default ? "-" : latest.ToString("yyyy-MM-dd HH:mm");
    }

    private static IidxDifficultyRecord GetDifficulty(IidxSongRecord song, string difficulty)
    {
        if (song.Difficulties.TryGetValue(difficulty, out var found))
        {
            return found;
        }

        return new IidxDifficultyRecord();
    }
}
