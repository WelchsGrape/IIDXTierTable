@page "/tier-table-hard"
@using IIDXTierTable.Models
@using IIDXTierTable.Services
@inject HttpClient Http
@inject TierTableDataService TierTableData
@inject BrowserStorageService Storage

<PageTitle>12 하드 서열표</PageTitle>

<h1>12 하드 서열표</h1>
<p>IIDXTierTableData.csv를 기준으로 HardType과 HardTier별 곡 목록을 보여줍니다.</p>

@if (isLoading)
{
    <div class="alert alert-info" role="alert">
        데이터를 불러오는 중입니다...
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (!tierRows.Any())
{
    <div class="alert alert-warning" role="alert">
        표시할 하드 서열 데이터가 없습니다.
    </div>
}
else
{
    <div class="matrix-controls mt-3">
        <div>
            <label for="viewMode" class="form-label mb-1">보기 방식</label>
            <select id="viewMode" class="form-select form-select-sm" @bind="selectedViewMode">
                <option value="@ViewMode.ByType">타입별 표 (지력/개인차 분리)</option>
                <option value="@ViewMode.ByTier">서열별 표 (지력 아래 개인차)</option>
            </select>
        </div>

        <div>
            <label for="columnCount" class="form-label mb-1">가로 칸 수</label>
            <select id="columnCount" class="form-select form-select-sm" @bind="columnCount">
                @foreach (var option in ColumnCountOptions)
                {
                    <option value="@option">@(option)칸</option>
                }
            </select>
        </div>
    </div>

    @if (selectedViewMode == ViewMode.ByType)
    {
        <div class="tier-matrix-groups mt-3">
            @foreach (var typeGroup in GroupedRows)
            {
                <section class="matrix-type-section">
                    <h2 class="type-title">@typeGroup.HardType</h2>

                    <div class="matrix-scroll">
                        <table class="matrix-table" aria-label="@($"{typeGroup.HardType} 하드 티어 표")">
                            <tbody>
                                @foreach (var tierName in TierOrder)
                                {
                                    if (ShouldSkipTierRow(typeGroup.HardType, tierName))
                                    {
                                        continue;
                                    }

                                    var songs = GetSongsByTier(typeGroup, tierName);
                                    var songRows = ChunkSongs(songs, columnCount);

                                    if (songRows.Count == 0)
                                    {
                                        <tr>
                                            <th scope="row" class="tier-header">@tierName</th>
                                            <td class="empty-cell" colspan="@columnCount">-</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        for (var rowIndex = 0; rowIndex < songRows.Count; rowIndex++)
                                        {
                                            var row = songRows[rowIndex];
                                            <tr>
                                                @if (rowIndex == 0)
                                                {
                                                    <th scope="row" class="tier-header" rowspan="@songRows.Count">@tierName</th>
                                                }

                                                @foreach (var song in row)
                                                {
                                                    <td class="song-td">
                                                        <div class="song-cell" title="@GetSongTooltip(song)">
                                                            <span class="lamp-cell @GetLampClass(song)" aria-hidden="true"></span>
                                                            <span class="song-title">@GetShortTitle(song.Title)</span>
                                                        </div>
                                                    </td>
                                                }

                                                @for (var i = row.Count; i < columnCount; i++)
                                                {
                                                    <td class="pad-cell"></td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="tier-matrix-groups mt-3">
            @foreach (var tierName in TierOrder)
            {
                var ziryukRows = ChunkSongs(GetSongsByTypeAndTier("지력", tierName), columnCount);
                var varianceRows = ChunkSongs(GetSongsByTypeAndTier("개인차", tierName), columnCount);

                <section class="matrix-type-section">
                    <div class="matrix-scroll">
                        <table class="matrix-table" aria-label="@($"{tierName} 하드 티어 비교 표")">
                            <tbody>
                                @if (ziryukRows.Count == 0)
                                {
                                    <tr>
                                        <th scope="row" class="tier-header">지력 @tierName</th>
                                        <td class="empty-cell" colspan="@columnCount">-</td>
                                    </tr>
                                }
                                else
                                {
                                    for (var rowIndex = 0; rowIndex < ziryukRows.Count; rowIndex++)
                                    {
                                        var row = ziryukRows[rowIndex];
                                        <tr>
                                            @if (rowIndex == 0)
                                            {
                                                <th scope="row" class="tier-header" rowspan="@ziryukRows.Count">지력 @tierName</th>
                                            }

                                            @foreach (var song in row)
                                            {
                                                <td class="song-td">
                                                    <div class="song-cell" title="@GetSongTooltip(song)">
                                                        <span class="lamp-cell @GetLampClass(song)" aria-hidden="true"></span>
                                                        <span class="song-title">@GetShortTitle(song.Title)</span>
                                                    </div>
                                                </td>
                                            }

                                            @for (var i = row.Count; i < columnCount; i++)
                                            {
                                                <td class="pad-cell"></td>
                                            }
                                        </tr>
                                    }
                                }

                                @if (!ShouldSkipTierRow("개인차", tierName))
                                {
                                    if (varianceRows.Count == 0)
                                    {
                                        <tr>
                                            <th scope="row" class="tier-header">개인차 @tierName</th>
                                            <td class="empty-cell" colspan="@columnCount">-</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        for (var rowIndex = 0; rowIndex < varianceRows.Count; rowIndex++)
                                        {
                                            var row = varianceRows[rowIndex];
                                            <tr>
                                                @if (rowIndex == 0)
                                                {
                                                    <th scope="row" class="tier-header" rowspan="@varianceRows.Count">개인차 @tierName</th>
                                                }

                                                @foreach (var song in row)
                                                {
                                                    <td class="song-td">
                                                        <div class="song-cell" title="@GetSongTooltip(song)">
                                                            <span class="lamp-cell @GetLampClass(song)" aria-hidden="true"></span>
                                                            <span class="song-title">@GetShortTitle(song.Title)</span>
                                                        </div>
                                                    </td>
                                                }

                                                @for (var i = row.Count; i < columnCount; i++)
                                                {
                                                    <td class="pad-cell"></td>
                                                }
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
}

@code {
    private static readonly string[] TierOrder = ["S+", "S", "A+", "A", "B+", "B", "C", "D", "E", "F"];
    private static readonly int[] ColumnCountOptions = [4, 5, 6, 7, 8, 9, 10];
    private IReadOnlyList<TierTableTitleRow> tierRows = Array.Empty<TierTableTitleRow>();
    private readonly Dictionary<string, string> clearTypeBySong = new(StringComparer.Ordinal);
    private bool isLoading = true;
    private string? errorMessage;
    private int columnCount = 6;
    private ViewMode selectedViewMode = ViewMode.ByType;

    private IEnumerable<HardTypeGroup> GroupedRows => tierRows
        .Where(static row => !string.IsNullOrWhiteSpace(row.HardType) && !string.IsNullOrWhiteSpace(row.HardTier))
        .GroupBy(row => row.HardType)
        .OrderBy(group => GetTypeOrder(group.Key))
        .ThenBy(group => group.Key)
        .Select(group => new HardTypeGroup
        {
            HardType = group.Key,
            Tiers = group
                .GroupBy(row => row.HardTier)
                .OrderBy(tier => GetTierOrder(tier.Key))
                .ThenBy(tier => tier.Key)
                .Select(tier => new HardTierGroup
                {
                    HardTier = tier.Key,
                    Songs = tier
                        .OrderBy(song => song.Title)
                        .ThenBy(song => song.Difficulty)
                        .ToList()
                })
                .ToList()
        });

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await TierTableData.InitializeAsync(Http);
            tierRows = TierTableData.Rows;
            errorMessage = TierTableData.ErrorMessage;
            await LoadUserScoreCacheAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"데이터를 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static IReadOnlyList<TierTableTitleRow> GetSongsByTier(HardTypeGroup typeGroup, string tierName)
    {
        return typeGroup.Tiers
            .FirstOrDefault(t => string.Equals(t.HardTier, tierName, StringComparison.OrdinalIgnoreCase))?.Songs
            ?? Array.Empty<TierTableTitleRow>();
    }

    private IReadOnlyList<TierTableTitleRow> GetSongsByTypeAndTier(string hardType, string tierName)
    {
        return tierRows
            .Where(row => string.Equals(row.HardType, hardType, StringComparison.OrdinalIgnoreCase)
                && string.Equals(row.HardTier, tierName, StringComparison.OrdinalIgnoreCase))
            .OrderBy(row => row.Title)
            .ThenBy(row => row.Difficulty)
            .ToList();
    }

    private static string GetShortTitle(string title)
    {
        const int maxLength = 16;
        if (title.Length <= maxLength)
        {
            return title;
        }

        return string.Concat(title.AsSpan(0, maxLength - 1), "…");
    }

    private async Task LoadUserScoreCacheAsync()
    {
        clearTypeBySong.Clear();

        var envelope = await Storage.GetItemAsync<IidxScoreEnvelope>(IidxStorageKeys.Scores);
        if (envelope is null)
        {
            return;
        }

        foreach (var song in envelope.Songs)
        {
            foreach (var difficulty in song.Difficulties)
            {
                var key = BuildSongKey(song.Title, difficulty.Key);
                clearTypeBySong[key] = difficulty.Value.ClearType;
            }
        }
    }

    private string GetSongTooltip(TierTableTitleRow row)
    {
        var clearType = GetClearType(row);
        return string.Concat(row.Title, " (", row.Difficulty, ") - ", clearType);
    }

    private string GetLampClass(TierTableTitleRow row)
    {
        var clearType = GetClearType(row);
        return clearType switch
        {
            "NO PLAY" => "lamp-no-play",
            "FAILED" => "lamp-failed",
            "ASSISTED CLEAR" => "lamp-assisted",
            "EASY CLEAR" => "lamp-easy",
            "CLEAR" => "lamp-clear",
            "HARD CLEAR" => "lamp-hard",
            "EX HARD CLEAR" => "lamp-ex-hard",
            "FULLCOMBO CLEAR" => "lamp-full-combo",
            _ => "lamp-no-play"
        };
    }

    private string GetClearType(TierTableTitleRow row)
    {
        var key = BuildSongKey(row.Title, row.Difficulty);
        if (clearTypeBySong.TryGetValue(key, out var clearType) && !string.IsNullOrWhiteSpace(clearType))
        {
            return clearType.Trim();
        }

        return "NO PLAY";
    }

    private static string BuildSongKey(string title, string difficulty)
    {
        return string.Concat(title.Trim(), "\u001f", difficulty.Trim());
    }

    private static List<List<TierTableTitleRow>> ChunkSongs(IReadOnlyList<TierTableTitleRow> songs, int chunkSize)
    {
        var chunks = new List<List<TierTableTitleRow>>();

        if (chunkSize <= 0 || songs.Count == 0)
        {
            return chunks;
        }

        for (var i = 0; i < songs.Count; i += chunkSize)
        {
            var size = Math.Min(chunkSize, songs.Count - i);
            var chunk = new List<TierTableTitleRow>(size);

            for (var j = i; j < i + size; j++)
            {
                chunk.Add(songs[j]);
            }

            chunks.Add(chunk);
        }

        return chunks;
    }

    private static int GetTypeOrder(string hardType)
    {
        return hardType switch
        {
            "지력" => 0,
            "개인차" => 1,
            _ => 2
        };
    }

    private static int GetTierOrder(string hardTier)
    {
        var index = Array.IndexOf(TierOrder, hardTier);
        return index >= 0 ? index : int.MaxValue;
    }

    private static bool ShouldSkipTierRow(string hardType, string hardTier)
    {
        return string.Equals(hardType, "개인차", StringComparison.OrdinalIgnoreCase)
            && string.Equals(hardTier, "F", StringComparison.OrdinalIgnoreCase);
    }

    private sealed class HardTypeGroup
    {
        public required string HardType { get; init; }

        public required IReadOnlyList<HardTierGroup> Tiers { get; init; }
    }

    private sealed class HardTierGroup
    {
        public required string HardTier { get; init; }

        public required IReadOnlyList<TierTableTitleRow> Songs { get; init; }
    }

    private enum ViewMode
    {
        ByType,
        ByTier
    }

}