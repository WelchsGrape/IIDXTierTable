@page "/import"
@using System.Text
@using IIDXTierTable.Models
@using IIDXTierTable.Services
@inject IidxCsvParser Parser
@inject BrowserStorageService Storage

<PageTitle>CSV 가져오기</PageTitle>

<h1>CSV 가져오기</h1>
<p class="mb-3">CSV 파일을 업로드하거나 데이터를 붙여넣어 기기에 저장합니다. 같은 기기로 재접속해도 저장된 데이터는 유지됩니다.</p>

<div class="alert alert-secondary" role="alert">
    <h2 class="h5 mb-3">CSV 추출 가이드</h2>
    <p class="mb-3">아래 링크에서 점수 데이터를 확인한 뒤, CSV 형식으로 추출해 이 페이지에 업로드하거나 붙여넣어 주세요.</p>
    <p class="mb-3">
        <a href="https://p.eagate.573.jp/game/2dx/33/djdata/score_download.html" target="_blank" rel="noopener noreferrer">
            e-amusement 점수 다운로드 페이지 열기 (프리미엄 코스 가입 필요)
        </a>
    </p>
    <ol class="mb-0">
        <li>위 링크에서 페이지를 열고 로그인합니다.</li>
        <li>CSV로 저장하거나 텍스트 형태로 복사합니다.</li>
        <li>CSV를 업로드하거나 텍스트를 붙여넣고 저장 버튼을 클릭합니다.</li>
    </ol>
</div>

<div class="import-layout">
    <section class="import-card">
        <h2>CSV 파일 업로드</h2>
        <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" class="form-control" disabled="@isProcessing" />
    </section>

    <section class="import-card">
        <h2>텍스트 붙여넣기</h2>
        <textarea class="form-control import-textarea" @bind="csvText" placeholder="여기에 CSV 내용을 붙여넣으세요"></textarea>
        <button class="btn btn-primary mt-3" @onclick="ParseAndSaveAsync" disabled="@isProcessing">@(isProcessing ? "처리 중..." : "저장")</button>
    </section>
</div>

@if (isProcessing)
{
    <div class="import-status mt-3" role="status" aria-live="polite" aria-busy="true">
        <p class="hint mb-0">@progressMessage</p>
    </div>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
        @statusMessage
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert-warning mt-3" role="alert">
        <strong>오류 목록</strong>
        <ul>
            @foreach (var error in errors.Take(20))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private const long MaxUploadSizeBytes = 1 * 1024 * 1024;

    private string csvText = string.Empty;
    private IBrowserFile? selectedFile;
    private string statusMessage = string.Empty;
    private string progressMessage = string.Empty;
    private bool isSuccess;
    private bool isProcessing;
    private List<string> errors = [];

    private Task OnFileSelected(InputFileChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isSuccess = false;
        errors.Clear();

        selectedFile = args.File;
        csvText = string.Empty;
        return Task.CompletedTask;
    }

    private async Task ParseAndSaveAsync()
    {
        errors.Clear();
        statusMessage = string.Empty;
        isSuccess = false;
        isProcessing = true;
        await Task.Yield();

        try
        {
            string content;

            if (selectedFile is not null)
            {
                if (!IsSupportedCsvFile(selectedFile, out var validationError))
                {
                    statusMessage = validationError;
                    return;
                }

                if (selectedFile.Size > MaxUploadSizeBytes)
                {
                    statusMessage = $"파일이 너무 큽니다. 업로드 가능한 최대 크기는 {MaxUploadSizeBytes / (1024 * 1024)}MB입니다.";
                    return;
                }

                progressMessage = "CSV 파일을 읽는 중입니다...";

                await using var stream = selectedFile.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes);
                using var reader = new StreamReader(stream);
                content = await reader.ReadToEndAsync();
            }
            else
            {
                content = csvText;
            }

            if (string.IsNullOrWhiteSpace(content))
            {
                statusMessage = "저장할 CSV 내용이 없습니다. 파일 업로드 또는 붙여넣기를 먼저 진행해 주세요.";
                return;
            }

            progressMessage = "CSV를 파싱하는 중입니다...";

            if (Encoding.UTF8.GetByteCount(content) > MaxUploadSizeBytes)
            {
                statusMessage = $"CSV 내용이 너무 큽니다. 최대 크기는 {FormatFileSize(MaxUploadSizeBytes)}입니다.";
                return;
            }

            var result = Parser.Parse(content);
            if (!result.IsSuccess || result.Envelope is null)
            {
                errors = [.. result.Errors];
                statusMessage = "CSV 파싱에 실패했습니다.";
                return;
            }

            progressMessage = "브라우저 저장소에 데이터를 저장하는 중입니다...";
            var jsonSizeBytes = await Storage.SetItemAsync(IidxStorageKeys.Scores, result.Envelope);

            isSuccess = true;
            statusMessage = $"저장 완료: {result.Envelope.Songs.Count:N0}곡이 기기에 저장되었습니다. JSON 데이터 크기: {FormatFileSize(jsonSizeBytes)}";
        }
        catch (JSException ex)
        {
            statusMessage = "브라우저 저장소에 데이터를 저장하지 못했습니다.";
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            statusMessage = "저장 처리 중 예기치 못한 오류가 발생했습니다.";
            errors.Add(ex.Message);
        }
        finally
        {
            isProcessing = false;
            progressMessage = string.Empty;
        }
    }

    private static bool IsSupportedCsvFile(IBrowserFile file, out string errorMessage)
    {
        var hasCsvExtension = file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase);
        var contentType = file.ContentType?.Trim() ?? string.Empty;
        var hasCsvContentType = string.Equals(contentType, "text/csv", StringComparison.OrdinalIgnoreCase)
            || string.Equals(contentType, "application/csv", StringComparison.OrdinalIgnoreCase)
            || string.Equals(contentType, "application/vnd.ms-excel", StringComparison.OrdinalIgnoreCase);

        if (hasCsvExtension || hasCsvContentType)
        {
            errorMessage = string.Empty;
            return true;
        }

        errorMessage = "CSV 파일만 업로드할 수 있습니다. 파일 확장자(.csv) 또는 형식을 확인해 주세요.";
        return false;
    }

    private static string FormatFileSize(long bytes)
    {
        const double bytesPerKilobyte = 1024;
        const double bytesPerMegabyte = bytesPerKilobyte * 1024;

        return bytes >= bytesPerMegabyte
            ? $"{bytes / bytesPerMegabyte:0.##}MB"
            : $"{bytes / bytesPerKilobyte:0.##}KB";
    }
}
