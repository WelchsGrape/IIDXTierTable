@page "/import"
@using System.Text
@using IIDXTierTable.Models
@using IIDXTierTable.Services
@inject IidxCsvParser Parser
@inject BrowserStorageService Storage

<PageTitle>플레이 데이터 가져오기</PageTitle>

<h1>플레이 데이터 가져오기</h1>
<p class="mb-3">플레이 데이터를 가져와 기기에 저장합니다. 같은 기기로 재접속하더라도 저장된 데이터는 유지됩니다.</p>

<div class="alert alert-secondary" role="alert">
    <h2 class="h5 mb-3">플레이 데이터 다운로드 방법</h2>
    <p class="mb-3">
        <a href="https://p.eagate.573.jp/game/2dx/33/djdata/score_download.html" target="_blank" rel="noopener noreferrer">
            플레이 데이터 CSV 다운로드 (프리미엄 코스 가입 필요)
        </a>
    </p>
    <ol class="mb-0">
        <li>페이지를 열고 로그인합니다.</li>
        <li>CSV로 저장하거나 텍스트 형태로 복사합니다.</li>
        <li>CSV를 업로드하거나 텍스트를 붙여넣고 저장 버튼을 클릭합니다. (약 5-10초 소요)</li>
    </ol>
</div>

<div class="import-layout">
    <section class="import-card @(openMode == ImportMode.File ? "is-open" : string.Empty)">
        <button type="button" class="import-card-header" @onclick="() => SelectMode(ImportMode.File)" aria-expanded="@(openMode == ImportMode.File)" disabled="@isProcessing">
            <span>방법 1) CSV 파일 업로드</span>
            <span aria-hidden="true">@(openMode == ImportMode.File ? "−" : "+")</span>
        </button>
        @if (openMode == ImportMode.File)
        {
            <div class="import-card-body">
                <InputFile OnChange="OnFileSelected" accept=".csv,text/csv" class="form-control" disabled="@isProcessing" />
            </div>
        }
    </section>

    <section class="import-card @(openMode == ImportMode.Text ? "is-open" : string.Empty)">
        <button type="button" class="import-card-header" @onclick="() => SelectMode(ImportMode.Text)" aria-expanded="@(openMode == ImportMode.Text)" disabled="@isProcessing">
            <span>방법 2) 텍스트 붙여넣기</span>
            <span aria-hidden="true">@(openMode == ImportMode.Text ? "−" : "+")</span>
        </button>
        @if (openMode == ImportMode.Text)
        {
            <div class="import-card-body">
                <textarea class="form-control import-textarea" @bind="csvText" placeholder="여기에 CSV 내용을 붙여넣으세요"></textarea>
            </div>
        }
    </section>
</div>

<button class="btn btn-primary mt-3" @onclick="ParseAndSaveAsync" disabled="@isProcessing">@(isProcessing ? "처리 중..." : "저장")</button>

@if (isProcessing)
{
    <div class="import-status mt-3" role="status" aria-live="polite" aria-busy="true">
        <div class="progress import-progress" role="progressbar" aria-label="CSV 처리 진행 상태" aria-valuetext="처리 중">
            <div class="progress-bar progress-bar-striped progress-bar-animated w-100"></div>
        </div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <div class="alert @(isSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
        @statusMessage
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert-warning mt-3" role="alert">
        <strong>오류 목록</strong>
        <ul>
            @foreach (var error in errors.Take(20))
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@code {
    private const long MaxUploadSizeBytes = 1 * 1024 * 1024;

    private ImportMode? openMode;
    private string csvText = string.Empty;
    private IBrowserFile? selectedFile;
    private string statusMessage = string.Empty;
    private bool isSuccess;
    private bool isProcessing;
    private List<string> errors = [];

    private void SelectMode(ImportMode mode)
    {
        if (openMode == mode)
        {
            openMode = null;
            return;
        }

        openMode = mode;
        if (mode == ImportMode.File)
        {
            csvText = string.Empty;
        }
        else
        {
            selectedFile = null;
        }
    }

    private Task OnFileSelected(InputFileChangeEventArgs args)
    {
        statusMessage = string.Empty;
        isSuccess = false;
        errors.Clear();

        selectedFile = args.File;
        csvText = string.Empty;
        return Task.CompletedTask;
    }

    private async Task ParseAndSaveAsync()
    {
        errors.Clear();
        statusMessage = string.Empty;
        isSuccess = false;
        isProcessing = true;
        await Task.Yield();

        try
        {
            var content = selectedFile is not null
                ? await ReadFileContentAsync(selectedFile)
                : csvText;

            if (content is null)
            {
                return;
            }

            if (string.IsNullOrWhiteSpace(content))
            {
                statusMessage = "저장할 CSV 내용이 없습니다. 파일 업로드 또는 붙여넣기를 먼저 진행해 주세요.";
                return;
            }

            if (Encoding.UTF8.GetByteCount(content) > MaxUploadSizeBytes)
            {
                statusMessage = $"CSV 내용이 너무 큽니다. 최대 크기는 {FormatFileSize(MaxUploadSizeBytes)}입니다.";
                return;
            }

            var result = Parser.Parse(content);
            if (!result.IsSuccess || result.Envelope is null)
            {
                errors = [.. result.Errors];
                statusMessage = "CSV 파싱에 실패했습니다.";
                return;
            }

            var jsonSizeBytes = await Storage.SetItemAsync(IidxStorageKeys.Scores, result.Envelope);

            isSuccess = true;
            statusMessage = $"{result.Envelope.Songs.Count:N0}개의 데이터가 기기에 저장되었습니다. ({FormatFileSize(jsonSizeBytes)})";
        }
        catch (JSException ex)
        {
            statusMessage = "브라우저 저장소에 데이터를 저장하지 못했습니다.";
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            statusMessage = "저장 처리 중 예기치 못한 오류가 발생했습니다.";
            errors.Add(ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task<string?> ReadFileContentAsync(IBrowserFile file)
    {
        if (!IsSupportedCsvFile(file, out var validationError))
        {
            statusMessage = validationError;
            return null;
        }

        if (file.Size > MaxUploadSizeBytes)
        {
            statusMessage = $"파일이 너무 큽니다. 업로드 가능한 최대 크기는 {MaxUploadSizeBytes / (1024 * 1024)}MB입니다.";
            return null;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes);
        using var reader = new StreamReader(stream);
        return await reader.ReadToEndAsync();
    }

    private static bool IsSupportedCsvFile(IBrowserFile file, out string errorMessage)
    {
        var hasCsvExtension = file.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase);
        var contentType = file.ContentType?.Trim() ?? string.Empty;
        var hasCsvContentType = string.Equals(contentType, "text/csv", StringComparison.OrdinalIgnoreCase)
            || string.Equals(contentType, "application/csv", StringComparison.OrdinalIgnoreCase)
            || string.Equals(contentType, "application/vnd.ms-excel", StringComparison.OrdinalIgnoreCase);

        if (hasCsvExtension || hasCsvContentType)
        {
            errorMessage = string.Empty;
            return true;
        }

        errorMessage = "CSV 파일만 업로드할 수 있습니다. 파일 확장자(.csv) 또는 형식을 확인해 주세요.";
        return false;
    }

    private static string FormatFileSize(long bytes)
    {
        const double bytesPerKilobyte = 1024;
        const double bytesPerMegabyte = bytesPerKilobyte * 1024;

        return bytes >= bytesPerMegabyte
            ? $"{bytes / bytesPerMegabyte:0.##}MB"
            : $"{bytes / bytesPerKilobyte:0.##}KB";
    }

    private enum ImportMode
    {
        File,
        Text
    }
}
