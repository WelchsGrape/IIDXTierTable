@page "/"
@using IIDXTierTable.Services
@inject HttpClient Http
@inject HomeUpdateDataService UpdateData

<PageTitle>Home</PageTitle>

<h1>Home</h1>

<p>서열표 개인화 기능은 CSV가 있어야 동작합니다. 처음 오셨다면 CSV를 먼저 등록해주세요.</p>

<div class="d-flex flex-wrap gap-2 mt-3">
	<a class="btn btn-primary" href="import">플레이 데이터 가져오기</a>
	<a class="btn btn-outline-primary" href="tier-table-hard">SP LEVEL 12 HARD</a>
	<a class="btn btn-outline-primary" href="tier-table-normal">SP LEVEL 12 NORMAL</a>
</div>

<section class="home-update-log mt-3">
    <h2>최근 업데이트 (09/03)</h2>
    <ul class="update-list">
        <li>업데이트 내역 표시 방법 변경</li>
    </ul>
</section>
@foreach (var section in UpdateData.Sections)
{
    <section class="home-update-log mt-3">
        <h2>@section.Title (@section.Date)</h2>
        <ul class="update-list">
            @foreach (var item in section.Items)
            {
                <li>
                    @item.Title
                    @if (!string.IsNullOrWhiteSpace(item.Detail))
                    {
                        <p class="update-detail">- @item.Detail</p>
                    }
                </li>
            }
        </ul>
    </section>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await UpdateData.InitializeAsync(Http);
    }
}
