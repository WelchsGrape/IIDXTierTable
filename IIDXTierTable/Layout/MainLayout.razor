@using IIDXTierTable.Models
@using IIDXTierTable.Services
@inject BrowserStorageService Storage

@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content">
            @Body
        </article>

        <footer class="app-refresh-note text-center">
            <p class="mt-2 text-muted d-none d-md-block">화면이 정상적으로 출력되지 않으면 강력 새로고침(Ctrl + F5)을 실행해주세요.</p>
            <p class="mt-2 text-muted d-block d-md-none">화면이 정상적으로 출력되지 않으면 새로고침을 하거나 브라우저를 종료하고 잠시 후에 접속해주세요.</p>
        </footer>
    </main>
</div>

@code {
    private bool cachePrimed;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || cachePrimed)
        {
            return;
        }

        cachePrimed = true;
        _ = Storage.PrimeCacheAsync<IidxScoreEnvelope>(IidxStorageKeys.Scores);
    }
}
